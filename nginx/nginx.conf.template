worker_processes auto;

events {
    worker_connections 2048;
}

http {

    include /etc/nginx/mime.types;

    default_type application/octet-stream;

    sendfile on;

    tcp_nopush on;

    keepalive_timeout 65;

    server_tokens off;

    # --------------------------------------------------
    # SECURITY / UPLOAD LIMIT
    # --------------------------------------------------

    client_max_body_size 20M;

    client_body_timeout 120s;

    client_header_timeout 30s;

    send_timeout 120s;


    # --------------------------------------------------
    # API KEY VALIDATION
    #
    # API key comes from:
    #
    # .env
    #
    # API_KEY=...
    # --------------------------------------------------

    map $http_x_api_key $api_key_valid {

        default 0;

        "${API_KEY}" 1;
    }


    server {

        listen 80;

        server_name _;


        # ==================================================
        # HEALTH CHECK
        # ==================================================

        location = /health {

            access_log off;

            default_type application/json;

            add_header
                Cache-Control
                "no-store";

            return 200
                '{"status":"ok","service":"nginx-upload"}';
        }


        # ==================================================
        # PUBLIC FILE ACCESS
        #
        # Example:
        #
        # https://files.yourdomain.com/erms/uploads/
        #
        # PROJECT_FOLDER comes from .env
        # ==================================================

        location /${PROJECT_FOLDER}/uploads/ {

            alias
                /data/uploads/${PROJECT_FOLDER}/uploads/;

            autoindex off;

            limit_except GET HEAD {

                deny all;
            }

            add_header
                X-Content-Type-Options
                "nosniff"
                always;

            add_header
                Cache-Control
                "public, max-age=2592000, immutable"
                always;
        }


        # ==================================================
        # UPLOAD / DELETE
        #
        # PUT:
        #
        # /erms/upload/employees/100001/profile/photo.jpg
        #
        # Physical:
        #
        # /data/uploads/erms/uploads/employees/100001/profile/photo.jpg
        #
        # PROJECT_FOLDER comes from .env
        # ==================================================

        location /${PROJECT_FOLDER}/upload/ {

            alias
                /data/uploads/${PROJECT_FOLDER}/uploads/;


            # ----------------------------------------------
            # API KEY
            # ----------------------------------------------

            if ($api_key_valid = 0) {

                add_header
                    WWW-Authenticate
                    'ApiKey realm="Upload Server"'
                    always;

                return 401;
            }


            # ----------------------------------------------
            # UPLOAD LIMIT
            # ----------------------------------------------

            client_max_body_size 20M;


            # ----------------------------------------------
            # TEMPORARY UPLOAD DIRECTORY
            # ----------------------------------------------

            client_body_temp_path
                /tmp/nginx_upload;


            # ----------------------------------------------
            # WEBDAV METHODS
            # ----------------------------------------------

            dav_methods
                PUT
                DELETE
                MKCOL
                COPY
                MOVE;


            dav_access
                user:rw
                group:rw
                all:r;


            create_full_put_path on;


            # ----------------------------------------------
            # ONLY ALLOW FILE OPERATIONS
            # ----------------------------------------------

            limit_except
                PUT
                DELETE
                MKCOL
                COPY
                MOVE {

                deny all;
            }


            # ----------------------------------------------
            # SECURITY HEADERS
            # ----------------------------------------------

            add_header
                X-Content-Type-Options
                "nosniff"
                always;

            add_header
                Cache-Control
                "no-store"
                always;


            # ----------------------------------------------
            # NO DIRECTORY LISTING
            # ----------------------------------------------

            autoindex off;
        }


        # ==================================================
        # BLOCK EVERYTHING ELSE
        # ==================================================

        location / {

            return 404;
        }
    }
}