worker_processes auto;

events {
    worker_connections 2048;
}

http {

    include /etc/nginx/mime.types;

    default_type application/octet-stream;

    sendfile on;
    tcp_nopush on;

    keepalive_timeout 65;

    server_tokens off;

    client_max_body_size 20M;

    client_body_timeout 120s;

    client_header_timeout 30s;

    send_timeout 120s;


    # ==================================================
    # API KEY
    # ==================================================

    map $http_x_api_key $api_key_valid {

        default 0;

        "${API_KEY}" 1;
    }


    # ==================================================
    # SERVER
    # ==================================================

    server {

        listen 80;

        server_name _;


        # ==================================================
        # HEALTH
        # ==================================================

        location = /health {

            access_log off;

            default_type application/json;

            add_header
                Cache-Control
                "no-store"
                always;

            return 200
                '{"status":"ok"}';
        }


        # ==================================================
        # PUBLIC FILES
        #
        # https://domain.com/erms/uploads/...
        # ==================================================

        location /${PROJECT_FOLDER}/uploads/ {

            alias
                /data/uploads/${PROJECT_FOLDER}/uploads/;

            autoindex off;

            limit_except GET HEAD {

                deny all;
            }

            add_header
                X-Content-Type-Options
                "nosniff"
                always;

            add_header
                Cache-Control
                "public, max-age=2592000, immutable"
                always;
        }


        # ==================================================
        # UPLOAD
        #
        # PUT
        # DELETE
        # MKCOL
        #
        # https://domain.com/erms/upload/...
        # ==================================================

        location /${PROJECT_FOLDER}/upload/ {

            alias
                /data/uploads/${PROJECT_FOLDER}/uploads/;


            # ----------------------------------------------
            # API KEY
            # ----------------------------------------------

            if ($api_key_valid = 0) {

                return 401;
            }


            # ----------------------------------------------
            # UPLOAD LIMIT
            # ----------------------------------------------

            client_max_body_size 20M;

            client_body_timeout 120s;

            client_body_temp_path
                /tmp/nginx_upload;


            # ----------------------------------------------
            # WEBDAV
            # ----------------------------------------------

            dav_methods
                PUT
                DELETE
                MKCOL;


            dav_access
                user:rw
                group:rw
                all:r;


            create_full_put_path on;


            # ----------------------------------------------
            # SECURITY
            # ----------------------------------------------

            add_header
                X-Content-Type-Options
                "nosniff"
                always;

            add_header
                Cache-Control
                "no-store"
                always;


            autoindex off;
        }


        # ==================================================
        # EVERYTHING ELSE
        # ==================================================

        location / {

            return 404;
        }
    }
}